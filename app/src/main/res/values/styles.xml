<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RetroMusic" parent="Theme.RetroMusic.Base" />

    <style name="Theme.RetroMusic.Light" parent="Theme.RetroMusic.Base.Light" />

    <style name="Theme.RetroMusic.Black" parent="Theme.RetroMusic.Base.Black" />

    <style name="Theme.RetroMusic.FollowSystem" parent="Theme.RetroMusic.Base.Adaptive">
        <item name="android:windowBackground">?colorSurface</item>
    </style>

    <style name="Theme.RetroMusic.MD3" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="roundSelector">@drawable/round_selector</item>
        <item name="rectSelector">@drawable/rect_selector</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        <item name="materialButtonStyle">@style/MaterialButtonTheme</item>

        <!-- Attribute Mappings -->
        <item name="TextViewHeadline2">@style/TextViewHeadline2</item>
        <item name="TextViewHeadline3">@style/TextViewHeadline3</item>
        <item name="TextViewHeadline4">@style/TextViewHeadline4</item>
        <item name="TextViewHeadline5">@style/TextViewHeadline5</item>
        <item name="TextViewHeadline6">@style/TextViewHeadline6</item>
        <item name="TextViewSubtitle1">@style/TextViewSubtitle1</item>
        <item name="TextViewSubtitle2">@style/TextViewSubtitle2</item>
        <item name="TextViewBody1">@style/TextViewBody1</item>
        <item name="TextViewBody2">@style/TextViewBody2</item>
        <item name="TextViewCaption">@style/TextViewCaption</item>
        <item name="TextViewButton">@style/TextViewButton</item>
        <item name="TextViewOverline">@style/TextViewOverline</item>
        <item name="TextViewNormal">@style/TextViewNormal</item>
        <item name="TextViewSubhead">@style/TextViewSubhead</item>
    </style>

    <style name="Theme.RetroMusic.Notification" parent="@android:style/TextAppearance.StatusBar.EventContent" />

    <style name="Theme.RetroMusic.Notification.Title" parent="@android:style/TextAppearance.StatusBar.EventContent.Title" />

    <style name="OverFlowButton">
        <item name="srcCompat">@drawable/ic_more_vert</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">?attr/roundSelector</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="MusicProgressSlider" parent="MusicProgressSliderParent">
        <item name="android:padding">0dp</item>
    </style>

    <style name="Toolbar" parent="Widget.Material3.Toolbar">
        <item name="popupTheme">?toolbarPopupTheme</item>
        <item name="android:transitionName" tools:ignore="NewApi">toolbar</item>
        <item name="layout_collapseMode">pin</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
        <item name="contentInsetStart">0dp</item>
        <item name="titleMarginStart">16dp</item>
    </style>

    <style name="mcab_overflow_style" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="srcCompat">@drawable/ic_more_vert</item>
        <item name="android:tint">?colorSurface</item>
    </style>

    <style name="ToolbarTextAppearanceNormal">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.0125</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="SubTitleTextAppearance">
        <item name="android:textAppearance">@style/TextViewOverline</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="BottomSheetItemTextAppearance" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Fab" parent="FabParent" />

    <!-- Font Size Theme Overlays -->
    <style name="FontSizeSmall">
        <item name="TextViewHeadline2">@style/TextViewHeadline2.Small</item>
        <item name="TextViewHeadline3">@style/TextViewHeadline3.Small</item>
        <item name="TextViewHeadline4">@style/TextViewHeadline4.Small</item>
        <item name="TextViewHeadline5">@style/TextViewHeadline5.Small</item>
        <item name="TextViewHeadline6">@style/TextViewHeadline6.Small</item>
        <item name="TextViewSubtitle1">@style/TextViewSubtitle1.Small</item>
        <item name="TextViewSubtitle2">@style/TextViewSubtitle2.Small</item>
        <item name="TextViewBody1">@style/TextViewBody1.Small</item>
        <item name="TextViewBody2">@style/TextViewBody2.Small</item>
        <item name="TextViewCaption">@style/TextViewCaption.Small</item>
        <item name="TextViewButton">@style/TextViewButton.Small</item>
        <item name="TextViewOverline">@style/TextViewOverline.Small</item>
        <item name="TextViewNormal">@style/TextViewNormal.Small</item>
        <item name="TextViewSubhead">@style/TextViewSubhead.Small</item>
    </style>

    <style name="FontSizeNormal">
        <item name="TextViewHeadline2">@style/TextViewHeadline2</item>
        <item name="TextViewHeadline3">@style/TextViewHeadline3</item>
        <item name="TextViewHeadline4">@style/TextViewHeadline4</item>
        <item name="TextViewHeadline5">@style/TextViewHeadline5</item>
        <item name="TextViewHeadline6">@style/TextViewHeadline6</item>
        <item name="TextViewSubtitle1">@style/TextViewSubtitle1</item>
        <item name="TextViewSubtitle2">@style/TextViewSubtitle2</item>
        <item name="TextViewBody1">@style/TextViewBody1</item>
        <item name="TextViewBody2">@style/TextViewBody2</item>
        <item name="TextViewCaption">@style/TextViewCaption</item>
        <item name="TextViewButton">@style/TextViewButton</item>
        <item name="TextViewOverline">@style/TextViewOverline</item>
        <item name="TextViewNormal">@style/TextViewNormal</item>
        <item name="TextViewSubhead">@style/TextViewSubhead</item>
    </style>

    <style name="FontSizeLarge">
        <item name="TextViewHeadline2">@style/TextViewHeadline2.Large</item>
        <item name="TextViewHeadline3">@style/TextViewHeadline3.Large</item>
        <item name="TextViewHeadline4">@style/TextViewHeadline4.Large</item>
        <item name="TextViewHeadline5">@style/TextViewHeadline5.Large</item>
        <item name="TextViewHeadline6">@style/TextViewHeadline6.Large</item>
        <item name="TextViewSubtitle1">@style/TextViewSubtitle1.Large</item>
        <item name="TextViewSubtitle2">@style/TextViewSubtitle2.Large</item>
        <item name="TextViewBody1">@style/TextViewBody1.Large</item>
        <item name="TextViewBody2">@style/TextViewBody2.Large</item>
        <item name="TextViewCaption">@style/TextViewCaption.Large</item>
        <item name="TextViewButton">@style/TextViewButton.Large</item>
        <item name="TextViewOverline">@style/TextViewOverline.Large</item>
        <item name="TextViewNormal">@style/TextViewNormal.Large</item>
        <item name="TextViewSubhead">@style/TextViewSubhead.Large</item>
    </style>

    <!-- Base Text Styles (Explicit Original Sizes + Offsets) -->
    <style name="TextViewHeadline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textSize">60sp</item>
    </style>
    <style name="TextViewHeadline2.Small" parent="TextViewHeadline2"><item name="android:textSize">56sp</item></style>
    <style name="TextViewHeadline2.Large" parent="TextViewHeadline2"><item name="android:textSize">64sp</item></style>

    <style name="TextViewHeadline3" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">48sp</item>
    </style>
    <style name="TextViewHeadline3.Small" parent="TextViewHeadline3"><item name="android:textSize">44sp</item></style>
    <style name="TextViewHeadline3.Large" parent="TextViewHeadline3"><item name="android:textSize">52sp</item></style>

    <style name="TextViewHeadline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">34sp</item>
    </style>
    <style name="TextViewHeadline4.Small" parent="TextViewHeadline4"><item name="android:textSize">30sp</item></style>
    <style name="TextViewHeadline4.Large" parent="TextViewHeadline4"><item name="android:textSize">38sp</item></style>

    <style name="TextViewHeadline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">24sp</item>
    </style>
    <style name="TextViewHeadline5.Small" parent="TextViewHeadline5"><item name="android:textSize">20sp</item></style>
    <style name="TextViewHeadline5.Large" parent="TextViewHeadline5"><item name="android:textSize">28sp</item></style>

    <style name="TextViewHeadline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextViewHeadline6.Small" parent="TextViewHeadline6"><item name="android:textSize">16sp</item></style>
    <style name="TextViewHeadline6.Large" parent="TextViewHeadline6"><item name="android:textSize">24sp</item></style>

    <style name="TextViewSubtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextViewSubtitle1.Small" parent="TextViewSubtitle1"><item name="android:textSize">12sp</item></style>
    <style name="TextViewSubtitle1.Large" parent="TextViewSubtitle1"><item name="android:textSize">20sp</item></style>

    <style name="TextViewSubtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextViewSubtitle2.Small" parent="TextViewSubtitle2"><item name="android:textSize">10sp</item></style>
    <style name="TextViewSubtitle2.Large" parent="TextViewSubtitle2"><item name="android:textSize">18sp</item></style>

    <style name="TextViewBody1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextViewBody1.Small" parent="TextViewBody1"><item name="android:textSize">12sp</item></style>
    <style name="TextViewBody1.Large" parent="TextViewBody1"><item name="android:textSize">20sp</item></style>

    <style name="TextViewBody2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextViewBody2.Small" parent="TextViewBody2"><item name="android:textSize">10sp</item></style>
    <style name="TextViewBody2.Large" parent="TextViewBody2"><item name="android:textSize">18sp</item></style>

    <style name="TextViewCaption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextViewCaption.Small" parent="TextViewCaption"><item name="android:textSize">8sp</item></style>
    <style name="TextViewCaption.Large" parent="TextViewCaption"><item name="android:textSize">16sp</item></style>

    <style name="TextViewButton" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextViewButton.Small" parent="TextViewButton"><item name="android:textSize">10sp</item></style>
    <style name="TextViewButton.Large" parent="TextViewButton"><item name="android:textSize">18sp</item></style>

    <style name="TextViewOverline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">10sp</item>
    </style>
    <style name="TextViewOverline.Small" parent="TextViewOverline"><item name="android:textSize">6sp</item></style>
    <style name="TextViewOverline.Large" parent="TextViewOverline"><item name="android:textSize">14sp</item></style>

    <style name="TextViewNormal" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextViewNormal.Small" parent="TextViewNormal"><item name="android:textSize">10sp</item></style>
    <style name="TextViewNormal.Large" parent="TextViewNormal"><item name="android:textSize">18sp</item></style>

    <style name="TextViewSubhead" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextViewSubhead.Small" parent="TextViewSubhead"><item name="android:textSize">12sp</item></style>
    <style name="TextViewSubhead.Large" parent="TextViewSubhead"><item name="android:textSize">20sp</item></style>

    <style name="TextViewNormalCompress" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextViewHeadline4.Compress" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TopCornerCardView">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
    </style>

    <style name="ClassicThemeOverLay">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="Theme.RetroMusic.SplashScreen" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="MaterialPopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_background</item>
    </style>

    <style name="CenteredCheckBoxTheme">
        <item name="checkboxStyle">@style/CheckBoxStyle</item>
    </style>

    <style name="CheckBoxStyle" parent="@style/Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:gravity">center_vertical|end</item>
    </style>

    <style name="MaterialAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">32dp</item>
    </style>

    <style name="AppTextAppearance.MaterialAlertDialog.Button" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="AppTextAppearance.MaterialAlertDialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">?attr/TextViewBody1</item>
        <item name="android:paddingTop">16dp</item>
    </style>

    <style name="AppTextAppearance.MaterialAlertDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">?attr/TextViewHeadline6</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MaterialButtonTheme" parent="Widget.Material3.Button">
        <item name="cornerRadius">6dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">?attr/colorControlNormal</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textAppearance">?attr/TextViewNormal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="android:maxWidth">@empty</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerMedium</item>
    </style>

    <style name="MaterialCardViewStroke">
        <item name="cardUseCompatPadding">true</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?android:attr/colorButtonNormal</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="circleImageView" parent="ShapeAppearance.MaterialComponents">
        <item name="cornerSize">40dp</item>
    </style>

    <style name="SearchChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="android:checked">false</item>
        <item name="android:textSize">16sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipEndPadding">10dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">10dp</item>
    </style>

    <style name="BottomSheetDialogStyle" parent="Theme.Design.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize|stateVisible</item>
    </style>

    <style name="HomeActionButton" parent="Widget.Material3.Button.ElevatedButton.Icon">
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="shapeAppearanceOverlay">
            @style/ShapeAppearanceOverlay.Material3.FloatingActionButton
        </item>
        <item name="iconPadding">16dp</item>
        <item name="iconGravity">start</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAppearance">?attr/TextViewBody2</item>
    </style>

    <style name="CarTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimaryDark">@color/md_deep_purple_700</item>
        <item name="colorAccent">@color/md_deep_purple_A400</item>
        <item name="colorPrimary">@color/md_deep_purple_500</item>
    </style>

    <style name="Theme.RetroMusic.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@drawable/rounded_drawable</item>
        <item name="android:windowFrame">@null</item>
        <item name="background">@color/transparent</item>
    </style>

